# Auth driver: "cognito" (default, AWS/Amplify) or "proxy" (BFF: oauth2-proxy +
# Keycloak; the SPA holds no token and calls the API same-origin via the proxy).
VITE_APP_AUTH_MODE=cognito

# --- cognito mode ---
VITE_APP_AUTH_REGION=ap-northeast-1
VITE_APP_AUTH_USER_POOL_ID=
VITE_APP_AUTH_USER_POOL_WEB_CLIENT_ID=
VITE_APP_AUTH_COOKIE_STORAGE_DOMAIN=localhost
# cognito: absolute URL of the Admin API. proxy: the same-origin prefix "/api".
VITE_APP_API_ENDPOINT=http://localhost:3000
# --- proxy mode (uncomment / override the two above) ---
# VITE_APP_AUTH_MODE=proxy
# VITE_APP_API_ENDPOINT=/api
# Account console for self-service password / MFA (IdP), e.g. Keycloak:
# VITE_APP_ACCOUNT_CONSOLE_URL=http://localhost:8081/realms/oqtopus/account

VITE_APP_NAME="OQTOPUS Admin"
VITE_USE_USERNAME=enable
VITE_USE_ORGANIZATION=enable
